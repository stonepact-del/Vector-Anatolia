{
  "name": "ankara-control",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/offline.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "prettier --check src tests scripts *.ts *.json *.html",
    "format": "prettier --write src tests scripts *.ts *.json *.html",
    "test:offline": "playwright test --config playwright.offline.config.ts"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "pixi.js": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "prettier": "^3.9.6",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  }
}
